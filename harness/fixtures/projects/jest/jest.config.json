{
  "testEnvironment": "node",
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "swcrc": false,
        "jsc": { "parser": { "syntax": "typescript" }, "target": "es2022" },
        "module": { "type": "commonjs" }
      }
    ]
  },
  "testMatch": ["<rootDir>/tests/**/*.test.ts"],
  "watchman": false
}
