{
  "rootDir": "../..",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "swcrc": false,
        "jsc": {
          "parser": { "syntax": "typescript" },
          "target": "es2024"
        },
        "module": { "type": "es6" }
      }
    ]
  },
  "testMatch": ["<rootDir>/harness/tests/**/*.test.ts"],
  "modulePathIgnorePatterns": ["<rootDir>/harness/fixtures/"],
  "watchman": false
}
