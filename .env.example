# How many test runners the mutation step starts at once.
# Default: 4, or the number of processors when the machine has fewer.
HARNESS_MUTATION_WORKERS=

# The memory the mutation step may take in all, in megabytes. With less
# memory it starts fewer test runners and takes longer. The least is 1280.
# Default: 4096.
HARNESS_MUTATION_MEMORY_MB=

# How long one mutant may run past its expected time, in milliseconds,
# before it counts as timed out. A slow machine may need more.
# Default: 15000.
HARNESS_MUTATION_TIMEOUT_MS=

# ---------------------------------------------------------------------
# The service. It reads these from the environment it is started in and
# never from a file, so export the ones you change. A wrong value stops
# the start, and the message names every wrong variable.
# ---------------------------------------------------------------------

# The folder that holds the database, the lock, the socket, the stored
# output of tools and the working copies. An absolute path, short enough
# for the path of a socket in it (104 bytes).
# Default: .coverage-autopilot under the home folder.
AUTOPILOT_INSTANCE_DIR=

# The least urgent lines the log keeps: debug, info, warn or error.
# Default: info.
AUTOPILOT_LOG_LEVEL=

# The program of the container engine and its first arguments, as a JSON
# list. Default: ["docker"].
AUTOPILOT_SANDBOX_ENGINE=

# The image the commands of a repository run in. Left at its default, the
# service builds the image itself from the file it ships: Node with the
# ps program, which the mutation tool needs. Any other name is used as the
# engine has it, or pulled once, and never built.
# Default: coverage-autopilot-sandbox:26.
AUTOPILOT_SANDBOX_IMAGE=

# The user and the group a sandboxed command runs as. Never 0.
# Default: the user and the group of the service.
AUTOPILOT_SANDBOX_UID=
AUTOPILOT_SANDBOX_GID=

# The limits of one sandbox: memory in megabytes, processors, processes
# and threads at once, the size of /tmp in megabytes, and how many bytes
# of output are kept from its end.
# Default: 4096, 2, 512, 512 and 1048576.
AUTOPILOT_SANDBOX_MEMORY_MB=
AUTOPILOT_SANDBOX_CPUS=
AUTOPILOT_SANDBOX_PROCESSES=
AUTOPILOT_SANDBOX_SCRATCH_MB=
AUTOPILOT_SANDBOX_OUTPUT_BYTES=

# The queue: how long a claim holds a job and how often a running job
# extends it, in milliseconds; the runs of one job before it is dead; how
# often the worker looks for a job, in milliseconds; and how many jobs of
# different repositories run at once.
# Default: 60000, 20000, 3, 1000 and 2.
AUTOPILOT_QUEUE_LEASE_MS=
AUTOPILOT_QUEUE_HEARTBEAT_MS=
AUTOPILOT_QUEUE_MAX_RUNS=
AUTOPILOT_QUEUE_POLL_MS=
AUTOPILOT_QUEUE_CONCURRENCY=

# The percent of lines a file is judged by when its repository has no
# threshold of its own: a file below it can be improved. A whole number
# from 1 to 100. `repo threshold <repo> <percent>` gives one repository
# its own, and `default` gives the default back.
# Default: 80.
AUTOPILOT_COVERAGE_THRESHOLD=

# How long the install of the packages of a repository, its tests and its
# type check may take, in milliseconds.
# Default: 600000, 900000 and 300000.
AUTOPILOT_INSTALL_TIMEOUT_MS=
AUTOPILOT_TEST_RUN_TIMEOUT_MS=
AUTOPILOT_TYPE_CHECK_TIMEOUT_MS=

# How long one whole run of the mutation tool may take, in milliseconds,
# and how many test runners it starts at once.
# Default: 1800000 and 2.
AUTOPILOT_MUTATION_RUN_TIMEOUT_MS=
AUTOPILOT_MUTATION_CONCURRENCY=

# How long one call of git and one call of gh may take, in milliseconds.
# Default: 600000 and 60000.
AUTOPILOT_GIT_TIMEOUT_MS=
AUTOPILOT_GH_TIMEOUT_MS=

# Who git writes as the author and the committer of every commit the
# service pushes. The default address is in a reserved domain, so no
# account of a code host is credited with the commits.
# Default: Coverage Autopilot and autopilot@coverage-autopilot.invalid.
AUTOPILOT_GIT_AUTHOR_NAME=
AUTOPILOT_GIT_AUTHOR_EMAIL=

# The CLI that writes the tests, and who pays for its calls: subscription
# or api_key. The credential itself is not set here: the service takes
# CLAUDE_CODE_OAUTH_TOKEN under a subscription and ANTHROPIC_API_KEY with
# a key from its environment, and never stores either.
# Default: claude_code and subscription.
AUTOPILOT_GENERATOR=
AUTOPILOT_GENERATOR_BILLING=

# The model the CLI is started with, and the image it runs in. The image
# must hold the CLI. Left at its default, the service builds the image
# itself from the file it ships, the first time it needs it and again
# when that file changes. Any other name is used as the engine has it, or
# pulled once, and never built.
# Default: sonnet and coverage-autopilot-generator:2.1.329.
AUTOPILOT_GENERATOR_MODEL=
AUTOPILOT_GENERATOR_IMAGE=

# The limits of one call of the generator: its turns, its time in
# milliseconds, and the bytes of its output that are kept.
# Default: 20, 600000 and 16777216.
AUTOPILOT_GENERATOR_MAX_TURNS=
AUTOPILOT_GENERATOR_TIMEOUT_MS=
AUTOPILOT_GENERATOR_OUTPUT_BYTES=

# The highest estimated price of one call, in US dollars. Only with
# AUTOPILOT_GENERATOR_BILLING=api_key: a subscription has no price of a
# call, and the variable is refused with it. Default: 1.
AUTOPILOT_GENERATOR_MAX_COST_USD=

# How long an improvement waits for a spent window of a subscription when
# the CLI did not say when it opens, in milliseconds.
# Default: 3600000.
AUTOPILOT_GENERATOR_LIMIT_WAIT_MS=

# The budget of an improvement that names none, and the most a request
# may ask for: attempts and minutes of work.
# Default: 3 and 30, and at most 10 and 120.
AUTOPILOT_BUDGET_ATTEMPTS=
AUTOPILOT_BUDGET_MINUTES=
AUTOPILOT_BUDGET_MAX_ATTEMPTS=
AUTOPILOT_BUDGET_MAX_MINUTES=

# The tokens of a budget. Only with AUTOPILOT_GENERATOR_BILLING=api_key:
# under a subscription its windows are the limit.
# Default: 1000000, and at most 5000000.
AUTOPILOT_BUDGET_TOKENS=
AUTOPILOT_BUDGET_MAX_TOKENS=
